doctype html
html
  head
    style.
      body {
        font-family: Arial, sans-serif;
        line-height: 1.6;
        color: #333;
        max-width: 600px;
        margin: 0 auto;
        padding: 20px;
      }
      .header {
        background-color: #4a90e2;
        color: white;
        padding: 20px;
        text-align: center;
        border-radius: 5px 5px 0 0;
      }
      .content {
        padding: 20px;
        border: 1px solid #ddd;
        border-top: none;
        border-radius: 0 0 5px 5px;
      }
      .button {
        display: inline-block;
        padding: 10px 20px;
        background-color: #4a90e2;
        color: white;
        text-decoration: none;
        border-radius: 5px;
        margin: 20px 0;
      }
      .footer {
        margin-top: 20px;
        font-size: 12px;
        text-align: center;
        color: #777;
      }
  body
    .header
      h1 Welcome to Our Platform!
    .content
      p Hello #{firstName},
      p Thank you for registering with us. We're excited to have you on board!
      p To get started, please verify your email address by clicking the button below:
      p(style="text-align: center;")
        a.button(href=`${url}`) Verify Email
      p If the button doesn't work, you can copy and paste this link into your browser:
      p #{url}
      p If you didn't create an account with us, please ignore this email.
    .footer
      p This email was sent to #{email} because you signed up for our service.
      p © #{new Date().getFullYear()} Your Company. All rights reserved.
