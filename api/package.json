{
  "name": "Api_v2_express",
  "version": "2.0.0",
  "description": "Posnic API v2 - Express.js Backend (1:1 PHP Replica)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest -c jest.ci.config.js --detectOpenHandles --forceExit",
    "test:unit": "jest -c jest.ci.config.js tests/unit --detectOpenHandles --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest -c jest.ci.config.js --coverage --detectOpenHandles --forceExit",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\"",
    "validate:config": "node scripts/validate-config.js",
    "test:db": "node scripts/test-db.js",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\"",
    "docs:api": "node scripts/generate-api-docs.js",
    "docs:lint": "redocly lint ../docs/openapi.json",
    "docs:check": "node scripts/generate-api-docs.js && git diff --exit-code ../docs/API.md ../docs/openapi.json",
    "test:ci": "jest -c jest.ci.config.js --detectOpenHandles --forceExit",
    "test:known-failures": "node scripts/known-failures.js",
    "test:local": "node scripts/test-local.js",
    "test:api": "node scripts/test-local.js tests/api --forceExit --runInBand",
    "audit:money": "node scripts/audit-money.js",
    "test:all": "jest --detectOpenHandles --forceExit",
    "test:coverage:all": "jest --coverage --detectOpenHandles --forceExit"
  },
  "keywords": [
    "posnic",
    "pos",
    "api",
    "express",
    "mongodb",
    "mongoose"
  ],
  "author": "Posnic Team",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@getbrevo/brevo": "^6.0.2",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "bson": "^7.3.1",
    "compression": "^1.8.1",
    "connect-mongo": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "html-to-text": "^10.0.0",
    "http-status": "^2.1.0",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.3",
    "mongodb": "^7.5.0",
    "mongoose": "^9.9.1",
    "mongoose-paginate-v2": "^1.9.5",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.19.1",
    "pug": "^3.0.4",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.8",
    "sib-api-v3-sdk": "^8.5.0",
    "uuid": "^14.0.1",
    "validator": "^13.15.35",
    "whatsapp-web.js": "^1.34.7",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "^2.46.0",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "glob": "^13.0.6",
    "globals": "^17.9.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "swagger-ui-express": "^5.0.1"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Posnic/POS.git"
  },
  "bugs": {
    "url": "https://github.com/Posnic/POS/issues"
  },
  "homepage": "https://github.com/Posnic/POS#readme",
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "deepmerge-ts": "^8.0.0"
  }
}
