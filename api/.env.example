# Copy to .env and fill in.
#
# Only needed to run the API on its own. The desktop app generates the secrets
# below per installation and passes them in, so a shop never sees this file.
#
# Nothing here has a default in the source. A shipped default is a secret
# shared by every installation in the world, which is precisely what this
# replaced.

# ---- required: the API refuses to start without these ----------------------

# Signs login tokens. Any long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Signs session cookies. Use a different value to the one above.
SESSION_SECRET=

# Encrypts record identifiers. AES-256-CBC, so exactly 32 characters for the
# key and exactly 16 for the IV.
ENCRYPTION_KEY=
ENCRYPTION_IV=

# ---- optional: each feature turns itself off when its value is absent -------

# Guards the kiosk and kitchen-display endpoints. Without it those routes
# refuse every request, which is the correct state for a shop not using them.
KIOSK_API_KEY=

MONGODB_URI=mongodb://localhost:27017/PosnicPro

JWT_EXPIRES_IN=30d
JWT_COOKIE_EXPIRES_IN=30

PORT=5000
NODE_ENV=development

# Public base URL used when returning uploaded image URLs.
# Example: http://192.168.1.5:5555
PUBLIC_SERVER_URL=

# File uploads to S3. Uploads are disabled without these.
S3_KEY=
S3_SECRET=
S3_BUCKET=
S3_REGION=ap-south-1

# Transactional email.
BREVO_API_KEY=

# SMS through MSG91.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
