doctype html
html
  head
    style.
      body {
        font-family: Arial, sans-serif;
        line-height: 1.6;
        color: #333;
        max-width: 600px;
        margin: 0 auto;
        padding: 20px;
      }
      .header {
        background-color: #e74c3c;
        color: white;
        padding: 20px;
        text-align: center;
        border-radius: 5px 5px 0 0;
      }
      .content {
        padding: 20px;
        border: 1px solid #ddd;
        border-top: none;
        border-radius: 0 0 5px 5px;
      }
      .button {
        display: inline-block;
        padding: 10px 20px;
        background-color: #e74c3c;
        color: white;
        text-decoration: none;
        border-radius: 5px;
        margin: 20px 0;
      }
      .footer {
        margin-top: 20px;
        font-size: 12px;
        text-align: center;
        color: #777;
      }
      .warning {
        background-color: #f8f9fa;
        border-left: 4px solid #e74c3c;
        padding: 10px 15px;
        margin: 15px 0;
      }
  body
    .header
      h1 Password Reset Request
    .content
      p Hello #{firstName},
      p We received a request to reset the password for your account. If you didn't make this request, you can safely ignore this email.
      p To reset your password, click the button below:
      p(style="text-align: center;")
        a.button(href=`${url}`) Reset Password
      .warning
        p This link will expire in 10 minutes for security reasons.
      p If the button doesn't work, copy and paste this link into your browser:
      p #{url}
      p If you didn't request a password reset, please ignore this email or contact support if you have any concerns.
    .footer
      p This email was sent to #{email} because a password reset was requested for your account.
      p © #{new Date().getFullYear()} Your Company. All rights reserved.
